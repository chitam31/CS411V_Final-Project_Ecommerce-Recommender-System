# Danh bạ cụm: nguồn sự thật duy nhất về 8 máy trong mạng ZeroTier ttunet.
# IP lấy từ ZeroTier Central (network 633e31d8a29b038c).
#
# Định dạng MAY_<n>="ten|ip_zerotier|vai_tro|so_loi|bo_nho_worker"
# vai_tro ghép bằng dấu phẩy: namenode, datanode, spark-master, spark-worker, kafka, airflow, web
#
# so_loi và bo_nho_worker là GIÁ TRỊ ƯỚC LƯỢNG THẬN TRỌNG, chưa đo trên máy thật.
# Trên mỗi máy chạy: nproc và free -g, rồi sửa cho đúng trước khi khởi động worker.

MAY_1="labsoe-11|10.68.71.113|namenode,spark-master,airflow|0|0"
MAY_2="labsit12|10.68.71.198|datanode,spark-worker|4|8g"
MAY_3="labsit|10.68.71.204|datanode,spark-worker,kafka|4|6g"
MAY_4="labsit-may25|10.68.71.42|datanode,spark-worker|4|8g"
MAY_5="labsit-may26|10.68.71.90|datanode,spark-worker|4|8g"
MAY_6="labsoe-18|10.68.71.149|datanode,spark-worker|4|8g"
MAY_7="ctam|10.68.71.205|web|0|0"
# Máy Windows cá nhân: chỉ dùng trình duyệt để mở web demo và các trang giám sát.
MAY_8="personal-windows|10.68.71.59|may-demo|0|0"
# Laptop Windows của Lê Chí Tâm (ZeroTier 354f36a46a): máy điều khiển cụm qua SSH và trình chiếu.
MAY_9="whitehathacker|10.68.71.182|may-demo|0|0"

# Tài khoản đăng nhập SSH của từng máy (whoami), dùng cho scripts/cum/ssh_tat_ca.sh --tao-config.
# Máy chưa có trong danh sách nhận tài khoản mặc định hduser.
TAI_KHOAN_SSH="labsoe-11=hduser labsit12=labsit12 labsit=labsit labsit-may25=labsit labsit-may26=labsit labsoe-18=labsoe-18"

